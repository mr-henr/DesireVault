{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desire Vault",
  "version": "0.1.0",
  "identifier": "com.flavio.gamelibrarymanager",
  "build": {
    "frontendDist": "src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Desire Vault",
        "width": 1440,
        "height": 920,
        "visible": false,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#111519",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: data: blob:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": ["icons/icon.png"],
    "category": "Game",
    "shortDescription": "Sua biblioteca pessoal de jogos",
    "longDescription": "Organize sua lista de jogos em uma biblioteca visual local."
  }
}

